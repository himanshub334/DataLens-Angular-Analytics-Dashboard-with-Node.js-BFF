{
  "$schema":"./node_modules/@angular/cli/lib/config/schema.json",
  "version":1,
  "projects":{
    "datalens-web":{
      "projectType":"application",
      "root":"",
      "sourceRoot":"src",
      "prefix":"app",
      "architect":{
        "build":{
          "builder":"@angular-devkit/build-angular:browser",
          "options":{
            "outputPath":"dist/datalens-web",
            "index":"src/index.html",
            "main":"src/main.ts",
            "polyfills":["zone.js"],
            "tsConfig":"tsconfig.app.json",
            "assets":["src/assets"],
            "styles":["src/styles.scss","@angular/material/prebuilt-themes/indigo-pink.css"]
          },
          "configurations":{
            "production":{"outputHashing":"all"}
          }
        },
        "serve":{
          "builder":"@angular-devkit/build-angular:dev-server",
          "configurations":{
            "production":{"browserTarget":"datalens-web:build:production"},
            "development":{"browserTarget":"datalens-web:build"}
          },
          "defaultConfiguration":"development"
        }
      }
    }
  },
  "defaultProject":"datalens-web"
}
